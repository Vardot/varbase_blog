<?php

/**
 * @file
 * Contains varbase_blog.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_blog\Hook\VarbaseBlogHooks;

/**
 * Implements hook_preprocess_HOOK() for menu.html.twig.
 */
#[LegacyHook]
function varbase_blog_preprocess_menu(&$variables) {
  \Drupal::service(VarbaseBlogHooks::class)->preprocessMenu($variables);
}
